{
    "compilerOptions": {
        "moduleResolution": "node",
        "target": "es2017",
        "module": "CommonJS",
        "outDir": "./dist",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
    },
    "include": [
        "src/**/*.ts"
    ]
}
